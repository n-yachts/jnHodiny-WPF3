<Window x:Class="jnHodiny.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:jnHodiny"
        Title="Nápověda – jn Hodiny"
        Width="620" Height="700" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="#F3F5F9"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F3A5F"/>
        </Style>

        <!-- Jedna položka: "klávesa / název" ve zvýrazněném štítku vlevo, popis vpravo -->
        <DataTemplate DataType="{x:Type local:HelpItem}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#E6EEF9" BorderBrush="#C5D5EE" BorderThickness="1" CornerRadius="6"
                        Padding="8,3" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="#1F3A5F" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="12,3,0,0"
                           TextWrapping="Wrap" Foreground="#333"/>
            </Grid>
        </DataTemplate>

        <!-- Sekce = karta s nadpisem, úvodním popisem a položkami -->
        <DataTemplate DataType="{x:Type local:HelpSection}">
            <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                    BorderBrush="#DDE3EE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Intro}" Margin="0,4,0,4" TextWrapping="Wrap" Foreground="#666">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Intro}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Záhlaví -->
        <Border Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F3A5F" Offset="0"/>
                    <GradientStop Color="#3B6EA8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🕒 jn Hodiny" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Plovoucí hodiny s rozvrhem zvonění – přehled ovládání a funkcí"
                           Foreground="#D6E4F7" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,2">
            <ItemsControl x:Name="SectionsList"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EE" BorderThickness="0,1,0,0" Padding="20,10">
            <Button Content="Zavřít" Width="100" Padding="0,5" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
